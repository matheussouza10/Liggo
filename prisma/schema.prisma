generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SYSTEM_ADMIN
  OWNER
  MEMBER
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       User[]
  invitations Invitation[]
  events      Event[]
  athletes    OrganizationAthlete[]
  teams       Team[]
  referees    Referee[]

  @@map("organizations")
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String
  passwordHash    String
  role            Role      @default(MEMBER)
  organizationId  String?
  /// Set when the person was deactivated: no sign in, sessions are gone. Never deleted, because events and lances reference who made them.
  disabledAt      DateTime?
  termsAcceptedAt DateTime?
  termsVersion    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization    Organization?         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  sessions        Session[]
  resetTokens     PasswordResetToken[]
  invitationsSent Invitation[]
  createdEvents   Event[]
  registrations   Registration[]
  matchEvents     MatchEvent[]
  decidedRequests RegistrationRequest[]

  @@index([organizationId])
  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

enum ParticipationType {
  INDIVIDUAL
  PAIR
  TEAM
}

model SportCategory {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String   @unique
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items Sport[]

  @@map("sport_categories")
}

model Sport {
  id         String   @id @default(cuid())
  slug       String   @unique
  name       String
  categoryId String
  sortOrder  Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category  SportCategory   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  events    Event[]
  referees  RefereeSport[]
  positions SportPosition[]

  @@unique([categoryId, name])
  @@index([categoryId])
  @@map("sports")
}

model EventTypeCategory {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String   @unique
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items EventType[]

  @@map("event_type_categories")
}

model EventType {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  categoryId  String
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category EventTypeCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  events   Event[]

  @@unique([categoryId, name])
  @@index([categoryId])
  @@map("event_types")
}

model FormatCategory {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String   @unique
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items CompetitionFormat[]

  @@map("format_categories")
}

model CompetitionFormat {
  id                 String              @id @default(cuid())
  slug               String              @unique
  name               String
  description        String?
  categoryId         String
  // Participation types this format supports. Empty means any.
  participationTypes ParticipationType[]
  allowsGroups       Boolean             @default(false)
  allowsRepechage    Boolean             @default(false)
  sortOrder          Int                 @default(0)
  active             Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  category FormatCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  events   Event[]

  @@unique([categoryId, name])
  @@index([categoryId])
  @@map("competition_formats")
}

model Event {
  id                   String            @id @default(cuid())
  organizationId       String
  createdById          String
  name                 String
  description          String?
  startDate            DateTime          @db.Date
  endDate              DateTime          @db.Date
  eventTypeId          String
  formatId             String
  sportId              String
  participationType    ParticipationType
  locationName         String
  city                 String?
  state                String?
  // Set when the first match is played; rules cannot change after that.
  rulesLockedAt        DateTime?
  // Whether the event shows on the public pages (/watch).
  publicVisible        Boolean           @default(true)
  // Public registration through /register/[id]; requests are approved by the organizer.
  registrationOpen     Boolean           @default(false)
  registrationDeadline DateTime?
  registrationNotes    String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy            User                  @relation(fields: [createdById], references: [id], onDelete: Restrict)
  eventType            EventType             @relation(fields: [eventTypeId], references: [id], onDelete: Restrict)
  format               CompetitionFormat     @relation(fields: [formatId], references: [id], onDelete: Restrict)
  sport                Sport                 @relation(fields: [sportId], references: [id], onDelete: Restrict)
  rules                EventRules?
  stages               EventStage[]
  categories           EventCategory[]
  registrations        Registration[]
  registrationRequests RegistrationRequest[]

  @@index([organizationId, startDate])
  @@index([eventTypeId])
  @@index([formatId])
  @@index([sportId])
  @@map("events")
}

enum ScoringModel {
  SETS
  POINTS
  PERFORMANCE
}

enum MatchFormat {
  SINGLE
  BEST_OF
  HOME_AWAY
}

enum StageType {
  ROUND_ROBIN
  GROUPS
  SINGLE_ELIM
  DOUBLE_ELIM
  SWISS
  PERFORMANCE
}

enum SeedingMode {
  MANUAL
  RANDOM
  RANKING
  SNAKE
}

enum GrandFinalMode {
  NONE
  SINGLE
  RESET
}

/// How the competition works. One row per event, created from a preset and
/// then edited by the organizer. Lists with a variable shape are JSON,
/// validated with zod (see src/lib/rules/schema.ts) and versioned.
model EventRules {
  id                 String       @id @default(cuid())
  eventId            String       @unique
  presetKey          String?
  schemaVersion      Int          @default(1)
  scoringModel       ScoringModel
  // Table points per result.
  winPoints          Float        @default(3)
  drawPoints         Float        @default(1)
  lossPoints         Float        @default(0)
  allowDraw          Boolean      @default(true)
  // Score-dependent points (volleyball, rugby); replaces the three above when set.
  pointsTable        Json?
  // Ordered list of { key, scope } criteria.
  tiebreakers        Json
  // Walkover / forfeit.
  woScoreFor         Int          @default(3)
  woScoreAgainst     Int          @default(0)
  woPointsAwarded    Float        @default(3)
  woPointsPenalty    Float        @default(0)
  woEliminationLimit Int?
  woNullifyResults   Boolean      @default(false)
  // Matches.
  matchFormat        MatchFormat  @default(SINGLE)
  bestOf             Int?
  extraTime          Boolean      @default(false)
  penalties          Boolean      @default(false)
  awayGoals          Boolean      @default(false)
  // Sport-specific block (sets, performance) and circuit ranking.
  sportConfig        Json?
  placePoints        Json?
  dropWorst          Int?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("event_rules")
}

/// An ordered phase of the event (for example groups, then knockout).
model EventStage {
  id                String         @id @default(cuid())
  eventId           String
  order             Int
  name              String
  type              StageType
  groupCount        Int?
  groupSize         Int?
  advancingPerGroup Int?
  roundRobinLegs    Int            @default(1)
  swissRounds       Int?
  thirdPlaceMatch   Boolean        @default(false)
  grandFinalMode    GrandFinalMode @default(NONE)
  seeding           SeedingMode    @default(MANUAL)
  /// Matchups by origin ("1st of Group A against 2nd of Group B"); empty means the automatic cross.
  pairings          Json?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  event Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  runs  StageRun[]

  @@unique([eventId, order])
  @@map("event_stages")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum RefereeRole {
  REFEREE
  JUDGE
  ASSISTANT
  TABLE_OFFICIAL
}

/// A person who competes. GLOBAL: not owned by any organization, so the same
/// athlete can take part in events of several organizations. The CPF (digits
/// only) is the identity; minors may have none and then need a guardian.
model Athlete {
  id                      String   @id @default(cuid())
  cpf                     String?  @unique
  name                    String
  birthDate               DateTime @db.Date
  gender                  Gender
  email                   String?
  phone                   String?
  guardianName            String?
  guardianCpf             String?
  // The organization that registered the athlete; only it may edit the data.
  createdByOrganizationId String?
  // Set when the athlete claims the record with their own account (future).
  userId                  String?  @unique
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  organizations OrganizationAthlete[]
  registrations RegistrationMember[]
  matchEvents   MatchEvent[]          @relation("MatchEventAthlete")
  matchEventsAs MatchEvent[]          @relation("MatchEventOther")

  @@index([createdByOrganizationId])
  @@map("athletes")
}

/// Which athletes an organization knows. An organization only ever sees the
/// athletes linked here.
model OrganizationAthlete {
  organizationId String
  athleteId      String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  athlete      Athlete      @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@id([organizationId, athleteId])
  @@index([athleteId])
  @@map("organization_athletes")
}

/// A team of one organization. It has no fixed roster: the roster is chosen
/// when the team is registered in an event.
model Team {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  shortName      String?
  city           String?
  state          String?
  color          String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  registrations Registration[]

  @@unique([organizationId, name])
  @@map("teams")
}

/// Referees, judges and officials of an organization (separate from athletes).
model Referee {
  id             String      @id @default(cuid())
  organizationId String
  name           String
  role           RefereeRole
  cpf            String?
  email          String?
  phone          String?
  licenseNumber  String?
  licenseEntity  String?
  active         Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  sports       RefereeSport[]
  matches      Match[]

  @@index([organizationId])
  @@map("referees")
}

model RefereeSport {
  refereeId String
  sportId   String

  referee Referee @relation(fields: [refereeId], references: [id], onDelete: Cascade)
  sport   Sport   @relation(fields: [sportId], references: [id], onDelete: Restrict)

  @@id([refereeId, sportId])
  @@index([sportId])
  @@map("referee_sports")
}

enum CategoryGender {
  MALE
  FEMALE
  MIXED
}

enum StaffRole {
  COACH
  ASSISTANT
  MANAGER
  PHYSIO
  OTHER
}

/// A playing position of a sport (goalkeeper, setter...), managed by the admin.
model SportPosition {
  id           String   @id @default(cuid())
  sportId      String
  name         String
  abbreviation String?
  sortOrder    Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sport          Sport                       @relation(fields: [sportId], references: [id], onDelete: Restrict)
  members        RegistrationMember[]
  requestMembers RegistrationRequestMember[]

  @@unique([sportId, name])
  @@map("sport_positions")
}

/// A division of one event (for example "Sub-15 Masculino"). Age limits are
/// evaluated on the event's start date.
model EventCategory {
  id        String         @id @default(cuid())
  eventId   String
  name      String
  gender    CategoryGender @default(MIXED)
  minAge    Int?
  maxAge    Int?
  rosterMin Int            @default(1)
  rosterMax Int?
  sortOrder Int            @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  event                Event                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrations        Registration[]
  members              RegistrationMember[]
  stageRuns            StageRun[]
  registrationRequests RegistrationRequest[]

  @@unique([eventId, name])
  @@index([eventId])
  @@map("event_categories")
}

/// A participant entry of an event: one athlete, a pair, or a team with the
/// roster chosen for THIS event.
model Registration {
  id          String   @id @default(cuid())
  eventId     String
  categoryId  String
  teamId      String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event     Event                @relation(fields: [eventId], references: [id], onDelete: Restrict)
  category  EventCategory        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  team      Team?                @relation(fields: [teamId], references: [id], onDelete: Restrict)
  createdBy User                 @relation(fields: [createdById], references: [id], onDelete: Restrict)
  members   RegistrationMember[]
  staff     RegistrationStaff[]
  entries   StageEntry[]
  request   RegistrationRequest?

  // A team enters a category once (several null teams are allowed).
  @@unique([categoryId, teamId])
  @@index([eventId])
  @@map("registrations")
}

model RegistrationMember {
  id             String   @id @default(cuid())
  registrationId String
  athleteId      String
  // Denormalized so the database can enforce one entry per athlete and category.
  categoryId     String
  shirtNumber    Int?
  positionId     String?
  isCaptain      Boolean  @default(false)
  createdAt      DateTime @default(now())

  registration Registration   @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  athlete      Athlete        @relation(fields: [athleteId], references: [id], onDelete: Restrict)
  category     EventCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  position     SportPosition? @relation(fields: [positionId], references: [id], onDelete: SetNull)

  @@unique([registrationId, athleteId])
  @@unique([categoryId, athleteId])
  @@unique([registrationId, shirtNumber])
  @@map("registration_members")
}

/// Coaching staff of one registration (not a global registry).
model RegistrationStaff {
  id             String    @id @default(cuid())
  registrationId String
  name           String
  role           StaffRole
  contact        String?
  createdAt      DateTime  @default(now())

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([registrationId])
  @@map("registration_staff")
}

enum StageRunStatus {
  /// Participants drawn; matches not generated yet.
  DRAWN
  /// Matches exist.
  LIVE
  /// Finished; qualified teams were sent to the next stage.
  DONE
}

enum MatchStatus {
  SCHEDULED
  FINISHED
  WALKOVER
}

enum MatchSlot {
  HOME
  AWAY
}

/// One stage played by one category. Each category is its own competition.
model StageRun {
  id            String         @id @default(cuid())
  stageId       String
  categoryId    String
  status        StageRunStatus @default(DRAWN)
  /// Seed of the draw, so it can be reproduced and audited.
  drawSeed      Int
  drawMode      SeedingMode
  /// True when the organizer chose who plays whom (knockout); then the order of the participants is the list of matchups.
  manualPairing Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  stage    EventStage    @relation(fields: [stageId], references: [id], onDelete: Restrict)
  category EventCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  groups   StageGroup[]
  entries  StageEntry[]
  matches  Match[]

  @@unique([stageId, categoryId])
  @@map("stage_runs")
}

model StageGroup {
  id         String @id @default(cuid())
  stageRunId String
  name       String
  order      Int

  stageRun StageRun     @relation(fields: [stageRunId], references: [id], onDelete: Cascade)
  entries  StageEntry[]
  matches  Match[]

  @@unique([stageRunId, order])
  @@map("stage_groups")
}

/// A participant (a registration) in one stage run.
model StageEntry {
  id             String  @id @default(cuid())
  stageRunId     String
  registrationId String
  groupId        String?
  /// Seed number (1 is the best); empty means unseeded.
  seed           Int?
  /// Position used to order the draw and the bracket.
  position       Int     @default(0)
  /// Where the participant came from, to name the matchups ("1º do Grupo A", "Vencedor do jogo 2").
  originGroup    Int?
  originRank     Int?
  originMatch    Int?

  stageRun     StageRun     @relation(fields: [stageRunId], references: [id], onDelete: Cascade)
  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  group        StageGroup?  @relation(fields: [groupId], references: [id], onDelete: SetNull)
  home         Match[]      @relation("MatchHome")
  away         Match[]      @relation("MatchAway")
  won          Match[]      @relation("MatchWinner")

  @@unique([stageRunId, registrationId])
  @@index([registrationId])
  @@map("stage_entries")
}

model Match {
  id             String      @id @default(cuid())
  stageRunId     String
  groupId        String?
  round          Int
  /// Order inside the round (also the bracket position).
  position       Int
  label          String?
  homeEntryId    String?
  awayEntryId    String?
  status         MatchStatus @default(SCHEDULED)
  homeScore      Int?
  awayScore      Int?
  homePenalties  Int?
  awayPenalties  Int?
  winnerEntryId  String?
  /// Where the winner goes (knockout) and where the loser goes (third place).
  nextMatchId    String?
  nextSlot       MatchSlot?
  loserMatchId   String?
  loserSlot      MatchSlot?
  scheduledAt    DateTime?
  venue          String?
  refereeId      String?
  /// Set when the match is started; with no final result the match is live.
  startedAt      DateTime?
  liveHome       Int         @default(0)
  liveAway       Int         @default(0)
  /// Ball possession of the home side, 0 to 100 (the away side is the rest).
  possessionHome Int?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  stageRun StageRun     @relation(fields: [stageRunId], references: [id], onDelete: Cascade)
  group    StageGroup?  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  home     StageEntry?  @relation("MatchHome", fields: [homeEntryId], references: [id], onDelete: SetNull)
  away     StageEntry?  @relation("MatchAway", fields: [awayEntryId], references: [id], onDelete: SetNull)
  winner   StageEntry?  @relation("MatchWinner", fields: [winnerEntryId], references: [id], onDelete: SetNull)
  referee  Referee?     @relation(fields: [refereeId], references: [id], onDelete: SetNull)
  events   MatchEvent[]
  sets     MatchSet[]

  @@index([stageRunId, round, position])
  @@index([refereeId, scheduledAt])
  @@index([scheduledAt])
  @@map("matches")
}

enum MatchEventType {
  KICKOFF
  PERIOD_START
  PERIOD_END
  FULL_TIME
  GOAL
  OWN_GOAL
  PENALTY_MISSED
  YELLOW_CARD
  RED_CARD
  FOUL
  SUBSTITUTION
  TIMEOUT
  INJURY
  NOTE
}

/// A moment of a match: goal, card, substitution, period start... Shown live
/// on the public page.
model MatchEvent {
  id             String         @id @default(cuid())
  matchId        String
  type           MatchEventType
  /// Which side the moment belongs to; empty for the match as a whole.
  side           MatchSlot?
  minute         Int?
  /// Player of the moment (scorer, carded, leaving the pitch).
  athleteId      String?
  /// Second player (assist, or who comes in on a substitution).
  otherAthleteId String?
  /// Points a score event is worth (1 for a goal; 2 or 3 in basketball).
  value          Int            @default(1)
  text           String?
  createdById    String
  createdAt      DateTime       @default(now())

  match        Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  athlete      Athlete? @relation("MatchEventAthlete", fields: [athleteId], references: [id], onDelete: SetNull)
  otherAthlete Athlete? @relation("MatchEventOther", fields: [otherAthleteId], references: [id], onDelete: SetNull)
  createdBy    User     @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([matchId, createdAt])
  @@map("match_events")
}

/// Link to choose a new password. Single use; only the hash of the token is stored.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

/// An invitation to join an organization by e-mail.
model Invitation {
  id             String    @id @default(cuid())
  organizationId String
  email          String
  role           Role      @default(MEMBER)
  tokenHash      String    @unique
  invitedById    String
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation(fields: [invitedById], references: [id], onDelete: Restrict)

  @@index([organizationId, email])
  @@map("invitations")
}

/// Where e-mails go in development when no SMTP server is configured. Never used in production.
model OutboundEmail {
  id        String   @id @default(cuid())
  toEmail   String
  subject   String
  text      String
  createdAt DateTime @default(now())

  @@index([toEmail, createdAt])
  @@map("outbound_emails")
}

/// A try of something that must be limited (sign in failures, password reset requests).
model AuthAttempt {
  id        String   @id @default(cuid())
  kind      String
  key       String
  createdAt DateTime @default(now())

  @@index([kind, key, createdAt])
  @@map("auth_attempts")
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

/// A public request to take part in an event, waiting for the organizer.
model RegistrationRequest {
  id              String        @id @default(cuid())
  eventId         String
  categoryId      String
  status          RequestStatus @default(PENDING)
  teamName        String?
  contactName     String
  contactEmail    String
  contactPhone    String?
  notes           String?
  consentAt       DateTime
  /// SHA-256 of the secret in the status link.
  tokenHash       String        @unique
  rejectionReason String?
  decidedAt       DateTime?
  decidedById     String?
  /// The registration created when approved.
  registrationId  String?       @unique
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  event        Event                       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  category     EventCategory               @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  decidedBy    User?                       @relation(fields: [decidedById], references: [id], onDelete: SetNull)
  registration Registration?               @relation(fields: [registrationId], references: [id], onDelete: SetNull)
  members      RegistrationRequestMember[]
  staff        RegistrationRequestStaff[]

  @@index([eventId, status])
  @@index([contactEmail])
  @@map("registration_requests")
}

model RegistrationRequestMember {
  id           String   @id @default(cuid())
  requestId    String
  name         String
  birthDate    DateTime @db.Date
  gender       Gender
  cpf          String?
  email        String?
  phone        String?
  guardianName String?
  guardianCpf  String?
  shirtNumber  Int?
  positionId   String?
  isCaptain    Boolean  @default(false)

  request  RegistrationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  position SportPosition?      @relation(fields: [positionId], references: [id], onDelete: SetNull)

  @@index([requestId])
  @@map("registration_request_members")
}

model RegistrationRequestStaff {
  id        String    @id @default(cuid())
  requestId String
  name      String
  role      StaffRole
  contact   String?

  request RegistrationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@map("registration_request_staff")
}

/// One set of a match scored by sets (volleyball, tennis...). Match.homeScore/awayScore hold the sets won.
model MatchSet {
  id         String @id @default(cuid())
  matchId    String
  number     Int
  homePoints Int
  awayPoints Int

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, number])
  @@map("match_sets")
}
