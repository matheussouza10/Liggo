DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/liggo?schema=public"

# Optional: creates the system admin when running `npm run db:seed`
ADMIN_EMAIL="admin@liggo.local"
ADMIN_PASSWORD="change-me-please"

# Public address of the app, used in the links of e-mails (reset password, invitations)
APP_URL="http://localhost:3000"

# E-mail (SMTP). Without SMTP_HOST, development keeps messages in the database
# table outbound_emails and prints them on the console; production refuses to send.
# SMTP_HOST="smtp.exemplo.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER="usuario"
# SMTP_PASS="senha"
# MAIL_FROM="Liggo <no-reply@seudominio.com.br>"


# Pagamentos (Asaas). A chave da API e o token do webhook são configurados no painel admin (/admin/payments).
# 32 bytes em base64 (openssl rand -base64 32). Obrigatória em produção: criptografa as chaves guardadas no banco.
PAYMENT_ENCRYPTION_KEY=
